{
  "name": "inventory-sync-service",
  "version": "0.1.0",
  "private": true,
  "description": "A service for maintaining inventory and synchronizing stock with supplier integrations.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "start": "node src/server.js",
    "start:supplier": "node src/mock-supplier/server.js",
    "check": "node scripts/check.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "validate": "npm run check && npm test"
  },
  "dependencies": {
    "axios": "1.20.0",
    "express": "5.1.0"
  }
}
